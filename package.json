{
  "name": "salles-api",
  "version": "0.4.2",
  "private": true,
  "type": "module",
  "description": "API de reservation de salles — service interne",
  "scripts": {
    "start": "tsx src/server.ts",
    "dev": "tsx watch src/server.ts",
    "test:unit": "vitest run",
    "lint": "eslint src test",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "build": "tsc -p tsconfig.build.json",
    "check": "bash scripts/checks.sh --strict",
    "check:advisory": "bash scripts/checks.sh",
    "test:harness": "node --test test/harness/*.test.mjs",
    "test:mutation": "node scripts/mutation.mjs",
    "test:coverage": "node scripts/coverage.mjs",
    "verify": "npm run check && npm run test:harness && npm run test:mutation",
    "hooks:install": "node scripts/install-hooks.mjs",
    "prepare": "node scripts/install-hooks.mjs"
  },
  "dependencies": {
    "express": "^4.21.2"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.2",
    "eslint": "^9.17.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.1",
    "vitest": "^2.1.8"
  }
}
